# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=apiuser
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ratelimit_api

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=24h

# Rate Limiting Configuration
RATE_LIMIT_FREE_TIER=60
RATE_LIMIT_PAID_TIER=600
RATE_LIMIT_BURST_MULTIPLIER=2
RATE_LIMIT_BURST_DURATION_MS=10000
RATE_LIMIT_VIOLATION_THRESHOLD=10
RATE_LIMIT_VIOLATION_WINDOW_MS=300000
RATE_LIMIT_SUSPENSION_DURATION_MS=900000

# Logging Configuration
LOG_LEVEL=info
LOG_BATCH_SIZE=1000
LOG_BATCH_INTERVAL_MS=5000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# AWS CloudWatch (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDWATCH_LOG_GROUP=/api/rate-limited-service
CLOUDWATCH_LOG_STREAM=production
